# 时区
TZ=Asia/Shanghai

# MumuBot 主模型 API Key
MUMU_LLM_API_KEY=

# 后台学习任务使用的辅助模型 API Key
# 留空时程序会尝试复用 MUMU_LLM_API_KEY
MUMU_AUX_LLM_API_KEY=

# Embedding 模型 API Key
# 留空时程序会尝试复用 MUMU_LLM_API_KEY
MUMU_EMBEDDING_API_KEY=

# 视觉模型 API Key
# 留空时程序会尝试复用 MUMU_LLM_API_KEY
MUMU_VISION_API_KEY=

# MySQL root 密码
MUMU_MYSQL_PASSWORD=mumu_local_pwd

# OneBot 鉴权 Token
# 如果你的 OneBot 服务端配置了 token，就在这里填写
MUMU_ONEBOT_TOKEN=

# MumuBot HTTP 服务映射端口
MUMU_HTTP_PORT=8080

# MySQL 映射到宿主机的端口
MYSQL_PORT=3306

# Milvus gRPC 端口
MILVUS_PORT=19530

# Milvus HTTP 管理端口
MILVUS_HTTP_PORT=9091

# MinIO API 端口
MINIO_PORT=9000

# MinIO Console 端口
MINIO_CONSOLE_PORT=9001

# MinIO 默认账号
MINIO_ROOT_USER=minioadmin

# MinIO 默认密码
MINIO_ROOT_PASSWORD=minioadmin
